---
import PageHead from '@/components/PageHead.astro'
import PageTitle from '@/components/PageTitle.astro'
import TravelLog, { type Place } from '@/components/travel/TravelLog'
import { PLACES } from '@/consts'
import Layout from '@/layouts/Layout.astro'
import { buildLandMask } from '@/lib/landmask'

const places: Place[] = PLACES
const mask = buildLandMask(places.map((p) => p.name))
---

<Layout class="max-w-7xl">
  <PageHead
    slot="head"
    title="Travel Log"
    description="Every country so far, traced from New Delhi."
  />
  <PageTitle
    label="traceroute --world"
    title="Travel"
    description="Every hop so far, routed from home. Drag the globe, hover a stamp or a hop to fly there."
    count={places.length}
  />
  <TravelLog client:load places={places} mask={mask} />
</Layout>
