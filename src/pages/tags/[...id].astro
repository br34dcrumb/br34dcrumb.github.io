---
import PageHead from '@/components/PageHead.astro'
import PageTitle from '@/components/PageTitle.astro'
import PostRow from '@/components/PostRow.astro'
import Layout from '@/layouts/Layout.astro'
import { getAllTags, getPostsByTag } from '@/lib/data-utils'

export async function getStaticPaths() {
  const tagMap = await getAllTags()
  const uniqueTags = Array.from(tagMap.keys())

  return Promise.all(
    uniqueTags.map(async (tag) => {
      const posts = await getPostsByTag(tag)
      return {
        params: { id: tag },
        props: {
          tag,
          posts,
        },
      }
    }),
  )
}

const { tag, posts } = Astro.props
---

<Layout class="max-w-7xl">
  <PageHead
    slot="head"
    title={`Posts tagged with "${tag}"`}
    description={`A collection of posts tagged with ${tag}.`}
    noindex
  />
  <PageTitle label={`grep -r "#${tag}"`} title={`#${tag}`} count={posts.length}>
    <a href="/tags" class="hover:text-phosphor text-muted-foreground text-sm transition-colors">← all tags</a>
  </PageTitle>
  <div class="border-border border-t">
    {posts.map((post, i) => <PostRow post={post} index={i} />)}
  </div>
</Layout>
