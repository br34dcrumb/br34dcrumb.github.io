---
import PageHead from '@/components/PageHead.astro'
import PageTitle from '@/components/PageTitle.astro'
import Layout from '@/layouts/Layout.astro'
import { getSortedTags } from '@/lib/data-utils'

const sortedTags = await getSortedTags()
const max = Math.max(...sortedTags.map((t) => t.count), 1)
---

<Layout class="max-w-7xl">
  <PageHead slot="head" title="Tags" />
  <PageTitle label="ls /usr/share/tags" title="Tags" count={sortedTags.length} />
  <div class="flex flex-wrap items-baseline gap-x-8 gap-y-4 pt-4">
    {
      sortedTags.map(({ tag, count }, i) => (
        <a
          href={`/tags/${tag}`}
          data-reveal
          style={`--i:${i % 6}; font-size: ${1.25 + (count / max) * 2.5}rem`}
          class="group hover:text-phosphor font-extrabold tracking-tighter transition-colors"
        >
          <span class="text-border group-hover:text-phosphor">#</span>
          {tag}
          <sup class="text-muted-foreground ml-1 text-xs font-normal">{count}</sup>
        </a>
      ))
    }
  </div>
</Layout>
