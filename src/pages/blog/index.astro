---
import PageHead from '@/components/PageHead.astro'
import PageTitle from '@/components/PageTitle.astro'
import PostRow from '@/components/PostRow.astro'
import Layout from '@/layouts/Layout.astro'
import { getAllPosts, getSortedTags, groupPostsByYear } from '@/lib/data-utils'

const allPosts = await getAllPosts()
const postsByYear = groupPostsByYear(allPosts)
const years = Object.keys(postsByYear).sort((a, b) => parseInt(b) - parseInt(a))
const tags = await getSortedTags()
---

<Layout class="max-w-7xl">
  <PageHead slot="head" title="Blog" description="CTF writeups and hardware hacking notes." />
  <PageTitle
    label="/var/log/writeups"
    title="Writeups"
    description="CTF writeups, hardware teardowns and notes from the bench. Mostly rev, side channels and things that weren't supposed to work."
    count={allPosts.length}
  >
    <div class="flex flex-wrap gap-2 text-xs" id="tag-filter" data-reveal style="--i:2">
      <button type="button" data-tag="" class="tag-btn is-active">*all</button>
      {
        tags.map(({ tag, count }) => (
          <button type="button" data-tag={tag} class="tag-btn">
            #{tag} <span class="opacity-50">{count}</span>
          </button>
        ))
      }
    </div>
  </PageTitle>

  <div class="flex flex-col gap-16 pt-6">
    {
      years.map((year) => (
        <section class="year-group grid gap-4 md:grid-cols-[10rem_1fr]">
          <h2
            class="text-border text-6xl font-extrabold tracking-tighter md:sticky md:top-24 md:self-start md:text-7xl"
            data-reveal
          >
            {year}
          </h2>
          <div class="border-border border-t">
            {postsByYear[year].map((post, i) => (
              <PostRow post={post} index={i} />
            ))}
          </div>
        </section>
      ))
    }
  </div>
</Layout>

<style>
  .tag-btn {
    border: 1px solid var(--border);
    padding: 0.35rem 0.7rem;
    color: var(--muted-foreground);
    transition:
      color 0.2s,
      border-color 0.2s,
      background 0.2s;
  }
  .tag-btn:hover {
    color: var(--foreground);
    border-color: var(--foreground);
  }
  .tag-btn.is-active {
    background: var(--phosphor);
    border-color: var(--phosphor);
    color: var(--primary-foreground);
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const filter = document.getElementById('tag-filter')
    if (!filter) return
    filter.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.tag-btn')
      if (!btn) return
      const tag = btn.dataset.tag ?? ''
      filter.querySelectorAll('.tag-btn').forEach((b) => b.classList.toggle('is-active', b === btn))
      document.querySelectorAll<HTMLElement>('.post-row').forEach((row) => {
        const tags = (row.dataset.tags ?? '').split(',')
        row.hidden = !!tag && !tags.includes(tag)
      })
      document.querySelectorAll<HTMLElement>('.year-group').forEach((g) => {
        g.hidden = !g.querySelector('.post-row:not([hidden])')
      })
    })
  })
</script>
