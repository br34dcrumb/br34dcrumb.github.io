---
import { getCombinedReadingTime, getSubpostCount } from '@/lib/data-utils'
import type { CollectionEntry } from 'astro:content'

interface Props {
  post: CollectionEntry<'blog'>
  index?: number
}

const { post, index = 0 } = Astro.props
const { title, description, date, tags } = post.data
const readTime = await getCombinedReadingTime(post.id)
const subposts = await getSubpostCount(post.id)
const stamp = date.toISOString().slice(0, 10).replaceAll('-', '.')
---

<a
  href={`/blog/${post.id}`}
  data-reveal
  style={`--i:${index}`}
  data-tags={(tags ?? []).join(',')}
  class="post-row group border-border relative grid grid-cols-1 gap-2 overflow-hidden border-b py-6 sm:grid-cols-[8rem_1fr_auto] sm:items-baseline sm:gap-6"
>
  <span
    class="bg-phosphor absolute inset-0 origin-left scale-x-0 transition-transform duration-500 ease-[cubic-bezier(0.7,0,0.2,1)] group-hover:scale-x-100"
  ></span>
  <time
    datetime={date.toISOString()}
    class="text-muted-foreground group-hover:text-primary-foreground relative text-xs tabular-nums transition-colors sm:pl-3"
  >
    {stamp}
  </time>
  <div class="relative">
    <h3
      class="group-hover:text-primary-foreground text-xl leading-tight font-bold tracking-tight transition-[color,transform] duration-300 group-hover:translate-x-2 sm:text-2xl"
    >
      {title}
    </h3>
    <p
      class="text-muted-foreground group-hover:text-primary-foreground/75 mt-1.5 line-clamp-2 text-sm transition-colors"
    >
      {description}
    </p>
    {
      tags && tags.length > 0 && (
        <ul class="text-muted-foreground group-hover:text-primary-foreground/70 mt-3 flex flex-wrap gap-x-3 text-xs transition-colors">
          {tags.map((t) => (
            <li>#{t}</li>
          ))}
        </ul>
      )
    }
  </div>
  <div
    class="text-muted-foreground group-hover:text-primary-foreground relative flex items-center gap-4 text-xs whitespace-nowrap transition-colors sm:pr-3"
  >
    {subposts > 0 && <span>{subposts} parts</span>}
    <span>{readTime}</span>
    <span class="text-lg transition-transform duration-300 group-hover:translate-x-1">→</span>
  </div>
</a>
